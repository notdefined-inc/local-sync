<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="ADHD Focus Dashboard - A productivity tool designed for the ADHD brain">
    <meta name="theme-color" content="#1A1B2E">
    <title>ADHD Focus Dashboard</title>
    
    <!-- PWA Manifest -->
    <link rel="manifest" href="manifest.json">
    <link rel="apple-touch-icon" href="icons/icon-192.png">
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        // Light theme
                        cream: '#FAF9F6',
                        surface: '#F0F0F0',
                        // Dark theme
                        navy: '#1A1B2E',
                        navyLight: '#252742',
                        // Accent colors
                        primary: '#5B8DEF',
                        primaryDark: '#6C9BCF',
                        secondary: '#7CB69D',
                        secondaryDark: '#5CAB7D',
                        coral: '#FF7675',
                        rose: '#E17055',
                        amber: '#FDCB6E',
                        gold: '#F9CA24',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Dexie.js for IndexedDB -->
    <script src="https://unpkg.com/dexie@latest/dist/dexie.js"></script>
    
    <!-- React CDN -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    
    <!-- Babel for JSX -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    
    <!-- DnD Kit for drag and drop -->
    <script src="https://cdn.jsdelivr.net/npm/@dnd-kit/core@6.1.0/dist/dnd-kit-core.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@dnd-kit/sortable@8.0.0/dist/dnd-kit-sortable.umd.min.js"></script>
    
    <style>
        /* Custom scrollbar */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #636E72; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #5B8DEF; }
        
        /* Smooth transitions */
        * { transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease; }
        
        /* Focus ring */
        *:focus { outline: 2px solid #5B8DEF; outline-offset: 2px; }
        
        /* Animation for focus timer */
        @keyframes pulse-soft {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .pulse-soft { animation: pulse-soft 2s ease-in-out infinite; }
        
        /* Progress ring animation */
        .progress-ring { transform: rotate(-90deg); transform-origin: 50% 50%; }
        
        /* Modal backdrop */
        .modal-backdrop {
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }
    </style>
</head>
<body class="font-sans">
    <div id="root"></div>
    
    <!-- Register Service Worker -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then((registration) => {
                        console.log('SW registered:', registration.scope);
                    })
                    .catch((error) => {
                        console.log('SW registration failed:', error);
                    });
            });
        }
        
        // Request notification permission
        if ('Notification' in window && Notification.permission === 'default') {
            Notification.requestPermission();
        }
    </script>
    
    <!-- notification sound placeholder 
    <audio id="notification-sound" preload="auto">
        <source src="sounds/gentle-bell.mp3" type="audio/mpeg">
    </audio> -->
    
    <script type="text/babel" data-presets="react">
        const { useState, useEffect, useCallback, createContext, useContext, useRef, useMemo } = React;

        // ============================================
        // DATABASE SETUP (Dexie.js)
        // ============================================
        const db = new Dexie('ADHDDashboard');
        db.version(2).stores({
            tasks: '++id, title, status, scheduledDate, priority, isCurrentFocus, createdAt, completedAt',
            routines: '++id, title, timeOfDay, reminderTime, estimatedMinutes, sortOrder',
            routineLogs: '++id, routineId, completedDate, completedAt',
            focusSessions: '++id, taskId, startedAt, endedAt, durationSeconds',
            blockers: '++id, parentTaskId, description, createdAt, resolved',
            settings: 'key',
            dailyStats: 'date'
        });

        // Default settings
        const defaultSettings = {
            theme: 'dark',
            focusDuration: 25, // minutes
            breakDuration: 5,
            bedtime: '23:30',
            reminderIntervals: [-60, -30, 0], 
            soundEnabled: true,
            gamificationEnabled: true,
        };

        // ============================================
        // CONTEXT
        // ============================================
        const AppContext = createContext();
        const useApp = () => useContext(AppContext);

        // ============================================
        // HOOKS
        // ============================================
        const useSettings = () => {
            const [settings, setSettings] = useState(defaultSettings);
            const [loading, setLoading] = useState(true);

            useEffect(() => {
                const loadSettings = async () => {
                    try {
                        const storedSettings = await db.settings.toArray();
                        const merged = { ...defaultSettings };
                        storedSettings.forEach(s => { merged[s.key] = s.value; });
                        setSettings(merged);
                    } catch (e) { console.error(e); }
                    setLoading(false);
                };
                loadSettings();
            }, []);

            const updateSetting = async (key, value) => {
                await db.settings.put({ key, value });
                setSettings(prev => ({ ...prev, [key]: value }));
            };
            return { settings, updateSetting, loading };
        };

        const useTasks = () => {
            const [tasks, setTasks] = useState([]);

            const loadTasks = useCallback(async () => {
                const all = await db.tasks.toArray();
                setTasks(all);
            }, []);

            useEffect(() => { loadTasks(); }, [loadTasks]);

            const addTask = async (task) => {
                await db.tasks.add({
                    ...task,
                    status: task.status || 'today',
                    priority: task.priority || 0,
                    isCurrentFocus: false,
                    createdAt: new Date().toISOString(),
                    scheduledDate: task.scheduledDate || new Date().toISOString().split('T')[0],
                });
                await loadTasks();
            };

            const updateTask = async (id, updates) => {
                await db.tasks.update(id, updates);
                await loadTasks();
            };

            const deleteTask = async (id) => {
                await db.tasks.delete(id);
                await loadTasks();
            };

            const setCurrentFocus = async (id) => {
                console.log("setCurrentFocus called with ID:", id, typeof id);
                try {
                    // Clear existing focus using filter (safer than index)
                    await db.tasks.filter(t => t.isCurrentFocus).modify({ isCurrentFocus: false });
                    
                    if (id) {
                        const taskId = Number(id); // Ensure number
                        console.log("Setting focus for normalized ID:", taskId);
                        
                        await db.tasks.update(taskId, { 
                            isCurrentFocus: true, 
                            status: 'progress' 
                        });
                        
                        const sessionData = {
                            taskId: taskId,
                            startedAt: new Date().toISOString(),
                        };
                        console.log("Adding focus session:", sessionData);
                        await db.focusSessions.add(sessionData);
                    }
                    await loadTasks();
                } catch (e) {
                    console.error("Focus error:", e);
                }
            };

            return { tasks, addTask, updateTask, deleteTask, setCurrentFocus, refresh: loadTasks };
        };

        // ============================================
        // COMPONENTS
        // ============================================

        const ThemeToggle = () => {
            const { settings, updateSetting } = useApp();
            const isDark = settings.theme === 'dark';
            const toggle = () => {
                const newTheme = isDark ? 'light' : 'dark';
                updateSetting('theme', newTheme);
                document.documentElement.classList.toggle('dark', newTheme === 'dark');
            };
            return (
                <button onClick={toggle} className="p-2 rounded-lg hover:bg-surface dark:hover:bg-navyLight transition-colors">
                    {isDark ? '☀️' : '🌙'}
                </button>
            );
        };

        const Header = ({ searchQuery, setSearchQuery }) => {
            return (
                <header className="bg-white dark:bg-navy border-b border-surface dark:border-navyLight px-4 py-3">
                    <div className="max-w-7xl mx-auto flex items-center justify-between">
                        <div className="flex items-center gap-3">
                            <div className="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center">
                                <svg className="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 10V3L4 14h7v7l9-11h-7z" />
                                </svg>
                            </div>
                            <h1 className="text-lg font-semibold text-gray-800 dark:text-white hidden sm:block">ADHD Focus</h1>
                        </div>
                        
                        <div className="flex items-center gap-2 flex-1 max-w-md mx-4">
                            <div className="relative w-full">
                                <input 
                                    type="text"
                                    value={searchQuery}
                                    onChange={(e) => setSearchQuery(e.target.value)}
                                    placeholder="Search tasks..."
                                    className="w-full px-3 py-1.5 rounded-lg bg-surface dark:bg-navyLight border border-gray-200 dark:border-gray-600 text-sm focus:border-primary"
                                />
                                <span className="absolute right-2 top-1.5 text-gray-400">🔍</span>
                            </div>
                        </div>

                        <div className="flex items-center gap-2">
                            <ThemeToggle />
                            <button className="p-2 rounded-lg hover:bg-surface dark:hover:bg-navyLight text-gray-600 dark:text-gray-300">
                                ⚙️
                            </button>
                        </div>
                    </div>
                </header>
            );
        };

        const FocusBanner = ({ task, onStop, onComplete, onSwitch }) => {
            const { settings } = useApp();
            const [timeLeft, setTimeLeft] = useState(settings.focusDuration * 60);
            const [status, setStatus] = useState('running'); // running, paused, break
            
            // Effect to calculate remaining time
            useEffect(() => {
                if (!task) {
                    console.log("FocusBanner: No task provided");
                    return;
                }
                
                console.log("FocusBanner: Checking sessions for task", task.id, typeof task.id);
                
                // Robust session finding: get all and filter
                db.focusSessions.toArray().then(sessions => {
                    console.log("FocusBanner: All sessions", sessions);
                    const session = sessions
                        .filter(s => {
                            // Loose comparison for safety
                            return s.taskId == task.id && s.startedAt;
                        })
                        .sort((a, b) => new Date(b.startedAt) - new Date(a.startedAt))[0];

                    console.log("FocusBanner: Found session?", session);

                    if (session) {
                        const start = new Date(session.startedAt).getTime();
                        const durationMs = settings.focusDuration * 60 * 1000;
                        const targetEnd = start + durationMs;
                        
                        const tick = () => {
                            const now = Date.now();
                            const diff = Math.ceil((targetEnd - now) / 1000);
                            
                            if (diff <= 0) {
                                setTimeLeft(0);
                                setStatus('completed');
                                // Only notify once
                                if (status === 'running') notifyComplete();
                            } else {
                                setTimeLeft(diff);
                            }
                        };
                        
                        tick();
                        const interval = setInterval(tick, 1000);
                        return () => clearInterval(interval);
                    } else {
                        // If no session found (rare race condition), maybe start one or default to full time
                        console.log("FocusBanner: No active session found for task");
                        setTimeLeft(settings.focusDuration * 60);
                    }
                });
            }, [task, settings.focusDuration]);

            const notifyComplete = () => {
                const audio = document.getElementById('notification-sound');
                if (audio) audio.play().catch(e => console.log('Audio play failed:', e));
                
                if (Notification.permission === 'granted') {
                    new Notification('Focus Session Complete!', {
                        body: `Great job on "${task.title}"! Take a break?`,
                        icon: 'icons/icon-192.png'
                    });
                }
            };

            const formatTime = (seconds) => {
                const m = Math.floor(seconds / 60);
                const s = seconds % 60;
                return `${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
            };

            if (!task) return (
                <div className="bg-surface dark:bg-navyLight mx-4 mt-4 rounded-xl p-4 border-2 border-dashed border-gray-300 dark:border-gray-600 text-center text-gray-500">
                    No task in focus. Pick one to start!
                </div>
            );

            return (
                <div className="bg-coral dark:bg-rose mx-4 mt-4 rounded-xl p-4 shadow-lg transition-colors">
                    <div className="flex items-center justify-between flex-wrap gap-4">
                        <div className="flex items-center gap-3">
                            <div className="w-3 h-3 rounded-full bg-white pulse-soft"></div>
                            <div>
                                <p className="text-white/80 text-xs font-bold tracking-wider">CURRENT FOCUS</p>
                                <h2 className="text-white text-xl font-bold truncate max-w-[200px] sm:max-w-md">{task.title}</h2>
                            </div>
                        </div>
                        <div className="text-right">
                            <p className="text-white text-4xl font-mono font-bold tracking-tight">{formatTime(timeLeft)}</p>
                        </div>
                    </div>
                    <div className="flex gap-2 mt-4">
                        <button onClick={onStop} className="px-3 py-1.5 bg-white/20 hover:bg-white/30 text-white rounded-lg text-sm font-medium transition-colors">⏸️ Pause</button>
                        <button onClick={onComplete} className="px-3 py-1.5 bg-white/20 hover:bg-white/30 text-white rounded-lg text-sm font-medium transition-colors">✅ Done</button>
                        <button onClick={onSwitch} className="px-3 py-1.5 bg-white/20 hover:bg-white/30 text-white rounded-lg text-sm font-medium transition-colors">🔄 Switch</button>
                    </div>
                </div>
            );
        };

        const TaskCard = ({ task, onFocus, onComplete, onDelete }) => {
            const handleDragStart = (e) => {
                e.dataTransfer.setData('text/plain', task.id);
                e.dataTransfer.effectAllowed = 'move';
                // Make ghost image distinct
                e.target.style.opacity = '0.5';
            };

            const handleDragEnd = (e) => {
                e.target.style.opacity = '1';
            };

            return (
                <div 
                    draggable="true"
                    onDragStart={handleDragStart}
                    onDragEnd={handleDragEnd}
                    className="bg-white dark:bg-navyLight rounded-lg p-3 shadow-sm border border-surface dark:border-navy hover:shadow-md transition-all cursor-grab active:cursor-grabbing group relative"
                >
                    <div className="flex items-start justify-between">
                        <h3 className="font-medium text-gray-800 dark:text-white flex-1 mr-2">{task.title}</h3>
                    </div>
                    {task.description && <p className="text-xs text-gray-500 mt-1 line-clamp-2">{task.description}</p>}
                    
                    <div className="flex items-center justify-between mt-3">
                        <div className="flex gap-1">
                            {task.priority > 0 && <span className="text-[10px] px-1.5 py-0.5 bg-amber/20 text-amber rounded">P{task.priority}</span>}
                        </div>
                        
                        <div className="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                            <button onClick={(e) => { e.stopPropagation(); onFocus(task); }} className="p-1 hover:bg-primary/20 rounded text-lg" title="Focus">🎯</button>
                            <button onClick={(e) => { e.stopPropagation(); onComplete(task); }} className="p-1 hover:bg-secondary/20 rounded text-lg" title="Done">✅</button>
                            <button onClick={(e) => { e.stopPropagation(); onDelete(task); }} className="p-1 hover:bg-coral/20 rounded text-lg" title="Delete">🗑️</button>
                        </div>
                    </div>
                </div>
            );
        };

        const KanbanColumn = ({ title, status, icon, tasks, onDropTask, onFocus, onComplete, onDelete }) => {
            const handleDragOver = (e) => {
                e.preventDefault(); // Necessary to allow dropping
                e.dataTransfer.dropEffect = 'move';
            };

            const handleDrop = (e) => {
                e.preventDefault();
                const taskId = parseInt(e.dataTransfer.getData('text/plain'));
                if (taskId) onDropTask(taskId, status);
            };

            return (
                <div 
                    onDragOver={handleDragOver}
                    onDrop={handleDrop}
                    className="flex-1 min-w-[280px] max-w-[350px] flex flex-col h-full"
                >
                    <div className="flex items-center gap-2 mb-3 px-1">
                        <span className="text-xl">{icon}</span>
                        <h3 className="font-semibold text-gray-700 dark:text-gray-200">{title}</h3>
                        <span className="text-xs bg-surface dark:bg-navy px-2 py-0.5 rounded-full text-gray-500">{tasks.length}</span>
                    </div>
                    <div className="flex-1 bg-surface/50 dark:bg-black/20 rounded-xl p-2 space-y-2 transition-colors hover:bg-surface/70 dark:hover:bg-black/30 min-h-[200px]">
                        {tasks.map(task => (
                            <TaskCard key={task.id} task={task} onFocus={onFocus} onComplete={onComplete} onDelete={onDelete} />
                        ))}
                        {tasks.length === 0 && <div className="h-20 flex items-center justify-center text-gray-400 text-sm border-2 border-dashed border-gray-300 dark:border-gray-700/50 rounded-lg">Drop tasks here</div>}
                    </div>
                </div>
            );
        };

        // Quick Add Task
        const QuickAddTask = ({ onAdd }) => {
            const [title, setTitle] = useState('');
            const [isOpen, setIsOpen] = useState(false);

            const handleSubmit = (e) => {
                e.preventDefault();
                if (title.trim()) {
                    onAdd({ title: title.trim() });
                    setTitle('');
                    setIsOpen(false);
                }
            };

            if (!isOpen) {
                return (
                    <button
                        onClick={() => setIsOpen(true)}
                        className="fixed bottom-6 right-6 w-14 h-14 bg-primary hover:bg-primary/90 text-white rounded-full shadow-lg flex items-center justify-center text-2xl z-50 transition-transform hover:scale-110"
                    >
                        +
                    </button>
                );
            }

            return (
                <div className="fixed inset-0 bg-black/50 modal-backdrop flex items-end sm:items-center justify-center z-50 p-4">
                    <div className="bg-white dark:bg-navyLight rounded-xl p-4 w-full max-w-md shadow-xl">
                        <h3 className="text-lg font-semibold text-gray-800 dark:text-white mb-3">Quick Add Task</h3>
                        <form onSubmit={handleSubmit}>
                            <input
                                type="text"
                                value={title}
                                onChange={(e) => setTitle(e.target.value)}
                                placeholder="What needs to be done?"
                                className="w-full px-4 py-3 rounded-lg bg-surface dark:bg-navy border border-gray-200 dark:border-gray-600 text-gray-800 dark:text-white placeholder-gray-400 focus:border-primary"
                                autoFocus
                            />
                            <div className="flex gap-2 mt-3">
                                <button
                                    type="button"
                                    onClick={() => setIsOpen(false)}
                                    className="flex-1 px-4 py-2 bg-surface dark:bg-navy text-gray-600 dark:text-gray-300 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700"
                                >
                                    Cancel
                                </button>
                                <button
                                    type="submit"
                                    className="flex-1 px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90"
                                >
                                    Add Task
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            );
        };

        // Tab Navigation
        const TabNav = ({ activeTab, setActiveTab }) => {
            const tabs = [
                { id: 'tasks', label: '📋 Tasks', icon: '📋' },
                { id: 'routines', label: '🔄 Routines', icon: '🔄' },
                { id: 'stats', label: '📊 Stats', icon: '📊' },
            ];

            return (
                <div className="flex gap-1 bg-surface dark:bg-navyLight mx-4 mt-4 p-1 rounded-lg">
                    {tabs.map(tab => (
                        <button
                            key={tab.id}
                            onClick={() => setActiveTab(tab.id)}
                            className={`flex-1 py-2 px-4 rounded-md font-medium transition-colors ${
                                activeTab === tab.id
                                    ? 'bg-white dark:bg-navy text-primary shadow-sm'
                                    : 'text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200'
                            }`}
                        >
                            {tab.label}
                        </button>
                    ))}
                </div>
            );
        };

        const useRoutines = () => {
            const [routines, setRoutines] = useState([]);
            const [logs, setLogs] = useState([]); // Today's logs

            const loadRoutines = useCallback(async () => {
                const all = await db.routines.toArray();
                const today = new Date().toISOString().split('T')[0];
                const todayLogs = await db.routineLogs.where('completedDate').equals(today).toArray();
                
                setRoutines(all);
                setLogs(todayLogs);
            }, []);

            useEffect(() => { loadRoutines(); }, [loadRoutines]);

            const addRoutine = async (routine) => {
                await db.routines.add({ ...routine });
                await loadRoutines();
            };

            const toggleRoutine = async (routineId) => {
                const today = new Date().toISOString().split('T')[0];
                const existingLog = logs.find(l => l.routineId === routineId);

                if (existingLog) {
                    await db.routineLogs.delete(existingLog.id);
                } else {
                    await db.routineLogs.add({
                        routineId,
                        completedDate: today,
                        completedAt: new Date().toISOString()
                    });
                }
                await loadRoutines();
            };

            const deleteRoutine = async (id) => {
                await db.routines.delete(id);
                await loadRoutines();
            };

            return { routines, logs, addRoutine, toggleRoutine, deleteRoutine };
        };

        // ... [Retain existing components] ...

        const RoutineCard = ({ routine, isDone, onToggle, onDelete }) => {
            return (
                <div className={`p-3 rounded-lg border flex items-center justify-between transition-all ${
                    isDone 
                        ? 'bg-green-50 dark:bg-green-900/10 border-green-200 dark:border-green-900/30' 
                        : 'bg-white dark:bg-navyLight border-gray-200 dark:border-gray-700'
                }`}>
                    <div className="flex items-center gap-3">
                        <button 
                            onClick={() => onToggle(routine.id)}
                            className={`w-6 h-6 rounded-full border-2 flex items-center justify-center transition-colors ${
                                isDone 
                                    ? 'bg-secondary border-secondary text-white' 
                                    : 'border-gray-300 dark:border-gray-500 hover:border-primary'
                            }`}
                        >
                            {isDone && '✓'}
                        </button>
                        <div>
                            <h4 className={`font-medium ${isDone ? 'text-gray-500 line-through' : 'text-gray-800 dark:text-white'}`}>
                                {routine.title}
                            </h4>
                            <p className="text-xs text-gray-500 flex items-center gap-2">
                                <span>⏰ {routine.timeOfDay}</span>
                                {routine.estimatedMinutes && <span>⏱️ {routine.estimatedMinutes}m</span>}
                            </p>
                        </div>
                    </div>
                    <button onClick={() => onDelete(routine.id)} className="text-gray-400 hover:text-coral transition-colors">
                        ×
                    </button>
                </div>
            );
        };

        const RoutinesView = () => {
            const { routines, logs, addRoutine, toggleRoutine, deleteRoutine } = useRoutines();
            const [showAddModal, setShowAddModal] = useState(false);

            const isDone = (id) => logs.some(l => l.routineId === id);

            const sections = ['morning', 'afternoon', 'evening'];
            const icons = { morning: '🌅', afternoon: '☀️', evening: '🌙' };

            return (
                <div className="max-w-4xl mx-auto p-4 space-y-6">
                    <div className="flex justify-between items-center">
                        <h2 className="text-xl font-bold text-gray-800 dark:text-white">Daily Routines</h2>
                        <button 
                            onClick={() => setShowAddModal(true)}
                            className="px-3 py-1.5 bg-primary text-white rounded-lg text-sm hover:bg-primary/90"
                        >
                            + Add Routine
                        </button>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                        {sections.map(time => (
                            <div key={time} className="bg-surface/50 dark:bg-navyLight/50 rounded-xl p-4">
                                <h3 className="font-semibold text-gray-700 dark:text-gray-200 mb-3 capitalize flex items-center gap-2">
                                    {icons[time]} {time}
                                </h3>
                                <div className="space-y-2">
                                    {routines.filter(r => r.timeOfDay === time).map(routine => (
                                        <RoutineCard 
                                            key={routine.id} 
                                            routine={routine} 
                                            isDone={isDone(routine.id)} 
                                            onToggle={toggleRoutine}
                                            onDelete={deleteRoutine}
                                        />
                                    ))}
                                    {routines.filter(r => r.timeOfDay === time).length === 0 && (
                                        <p className="text-sm text-gray-400 text-center py-2">No routines</p>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>

                    {showAddModal && (
                        <div className="fixed inset-0 bg-black/50 modal-backdrop flex items-center justify-center z-50 p-4">
                            <div className="bg-white dark:bg-navyLight rounded-xl p-6 w-full max-w-md shadow-xl">
                                <h3 className="text-lg font-bold text-gray-800 dark:text-white mb-4">Add New Routine</h3>
                                <form onSubmit={(e) => {
                                    e.preventDefault();
                                    const formData = new FormData(e.target);
                                    addRoutine({
                                        title: formData.get('title'),
                                        timeOfDay: formData.get('timeOfDay'),
                                        estimatedMinutes: parseInt(formData.get('estimatedMinutes')) || 5,
                                        sortOrder: 0
                                    });
                                    setShowAddModal(false);
                                }}>
                                    <div className="space-y-4">
                                        <div>
                                            <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Title</label>
                                            <input name="title" required className="w-full px-3 py-2 rounded-lg bg-surface dark:bg-navy border border-gray-200 dark:border-gray-600 dark:text-white" placeholder="e.g. Meditate" />
                                        </div>
                                        <div className="grid grid-cols-2 gap-4">
                                            <div>
                                                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Time of Day</label>
                                                <select name="timeOfDay" className="w-full px-3 py-2 rounded-lg bg-surface dark:bg-navy border border-gray-200 dark:border-gray-600 dark:text-white">
                                                    <option value="morning">Morning</option>
                                                    <option value="afternoon">Afternoon</option>
                                                    <option value="evening">Evening</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Duration (m)</label>
                                                <input type="number" name="estimatedMinutes" defaultValue="5" className="w-full px-3 py-2 rounded-lg bg-surface dark:bg-navy border border-gray-200 dark:border-gray-600 dark:text-white" />
                                            </div>
                                        </div>
                                        <div className="flex justify-end gap-2 mt-6">
                                            <button type="button" onClick={() => setShowAddModal(false)} className="px-4 py-2 text-gray-600 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg">Cancel</button>
                                            <button type="submit" className="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary/90">Add Routine</button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        const App = () => {
            const { settings, updateSetting, loading } = useSettings();
            const { tasks, addTask, updateTask, deleteTask, setCurrentFocus } = useTasks();
            const [activeTab, setActiveTab] = useState('tasks');
            const [searchQuery, setSearchQuery] = useState('');

            useEffect(() => {
                document.documentElement.classList.toggle('dark', settings.theme === 'dark');
            }, [settings.theme]);

            const currentFocusTask = tasks.find(t => t.isCurrentFocus);

            const filteredTasks = tasks.filter(t => 
                t.title.toLowerCase().includes(searchQuery.toLowerCase())
            );

            const handleDropTask = (taskId, newStatus) => {
                updateTask(taskId, { status: newStatus });
            };

            if (loading) return <div className="h-screen flex items-center justify-center bg-cream dark:bg-navy text-primary">Loading...</div>;

            return (
                <AppContext.Provider value={{ settings, updateSetting }}>
                    <div className="min-h-screen bg-cream dark:bg-navy pb-20">
                        <Header searchQuery={searchQuery} setSearchQuery={setSearchQuery} />
                        
                        <FocusBanner 
                            task={currentFocusTask}
                            onStop={() => setCurrentFocus(null)}
                            onComplete={() => updateTask(currentFocusTask.id, { status: 'done', isCurrentFocus: false })}
                            onSwitch={() => setCurrentFocus(null)}
                        />
                        
                        <div className="flex gap-1 bg-surface dark:bg-navyLight mx-4 mt-4 p-1 rounded-lg max-w-md">
                            {['tasks', 'routines', 'stats'].map(tab => (
                                <button
                                    key={tab}
                                    onClick={() => setActiveTab(tab)}
                                    className={`flex-1 py-1.5 px-3 rounded-md text-sm font-medium capitalize transition-all ${
                                        activeTab === tab ? 'bg-white dark:bg-navy text-primary shadow-sm' : 'text-gray-500 hover:text-gray-700 dark:text-gray-400'
                                    }`}
                                >
                                    {tab}
                                </button>
                            ))}
                        </div>
                        
                        <main className="mt-4">
                            {activeTab === 'tasks' && (
                                <div className="flex gap-4 overflow-x-auto px-4 pb-4 min-h-[500px]">
                                    <KanbanColumn 
                                        title="Today" status="today" icon="📅" 
                                        tasks={filteredTasks.filter(t => t.status === 'today')} 
                                        onDropTask={handleDropTask} onFocus={setCurrentFocus} onComplete={(t) => updateTask(t.id, { status: 'done' })} onDelete={(t) => deleteTask(t.id)}
                                    />
                                    <KanbanColumn 
                                        title="In Progress" status="progress" icon="🚀" 
                                        tasks={filteredTasks.filter(t => t.status === 'progress')} 
                                        onDropTask={handleDropTask} onFocus={setCurrentFocus} onComplete={(t) => updateTask(t.id, { status: 'done' })} onDelete={(t) => deleteTask(t.id)}
                                    />
                                    <KanbanColumn 
                                        title="Done" status="done" icon="✅" 
                                        tasks={filteredTasks.filter(t => t.status === 'done')} 
                                        onDropTask={handleDropTask} onFocus={setCurrentFocus} onComplete={(t) => updateTask(t.id, { status: 'done' })} onDelete={(t) => deleteTask(t.id)}
                                    />
                                </div>
                            )}
                            {activeTab === 'routines' && <RoutinesView />}
                            {activeTab === 'stats' && <div className="p-4 text-center text-gray-500">Stats coming soon</div>}
                        </main>
                        
                        <QuickAddTask onAdd={addTask} />
                    </div>
                </AppContext.Provider>
            );
        };


        // ============================================
        // RENDER
        // ============================================
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
