    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@localsync/core": "workspace:*",
    "@vlcn.io/crsqlite": "^0.16.3",
    "better-sqlite3": "^9.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
